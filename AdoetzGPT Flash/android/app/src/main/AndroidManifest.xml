<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Network ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Microphone ── -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ── Foreground Service (voice/audio session) ── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ── Notifications (API 33+) ── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Wake lock (keep audio alive while backgrounded) ── -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ── Camera (file/photo upload in Open WebUI) ── -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ── Storage (file download/upload) ── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- ── Vibrate ── -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".FlashApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdoetzGPTFlash"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- ── Main WebView Activity ── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation|uiMode|smallestScreenSize|density"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:documentLaunchMode="never"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AdoetzGPTFlash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Background Microphone Foreground Service ── -->
        <service
            android:name=".service.VoiceSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <!-- ── Capacitor provider ── -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:replace="android:authorities">
            <meta-data
                android:name="androidx.datastore.DataStoreInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

    <!-- Queries for speech recognition -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Allow browsing to external links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
